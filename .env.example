NEXT_PUBLIC_WORDPRESS_URL=https://cms.grippy.io
WC_CONSUMER_KEY=ck_your_consumer_key
WC_CONSUMER_SECRET=cs_your_consumer_secret

# WordPress Application Password (Users → Profile → Application Passwords)
# Used by /api/waitlist and /api/blind-test/* to write into WP Admin
WP_APPLICATION_USER=your_wp_username
WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Unlocks /blind-test/lab and /blind-test/results (httpOnly cookie session)
BLIND_TEST_ACCESS_KEY=choose-a-long-secret-for-lab-and-results
